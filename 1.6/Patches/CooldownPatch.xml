<?xml version="1.0" encoding="utf-8"?>
<Patch>
    <!--
        Manipulation now drives cooldown through a multiplicative StatPart (see
        StatPart_ManipulationCooldown) rather than a capacityOffset + postProcessCurve.
        A StatPart multiplies the already-combined stat value, so our effect stacks cleanly
        with other cooldown modifiers (expertise, apparel, traits, genes) instead of sweeping
        their contributions through our curve and turning buffs into nerfs. Enable/disable and
        curve settings are read live by the StatPart, so no restart is needed to change them.
    -->
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/StatDef[defName = "RangedCooldownFactor"]</xpath>
        <value>
            <parts>
                <li Class="ConfigurableDynamicCooldown.StatPart_ManipulationCooldown" />
            </parts>
        </value>
    </Operation>

    <Operation Class="PatchOperationAdd">
        <xpath>Defs/StatDef[defName = "MeleeCooldownFactor"]</xpath>
        <value>
            <parts>
                <li Class="ConfigurableDynamicCooldown.StatPart_ManipulationCooldown" />
            </parts>
        </value>
    </Operation>
</Patch>
